# Copy to .env (chmod 600). Nothing in this file is optional except where noted.

# --- box ---------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
SERVICE_TOKEN=change-me-long-random          # n8n → brief service auth
N8N_HOST=ops.acme.example.com                # public hostname for webhooks (RUNBOOK 8)

# --- Microsoft 365, Path A (AUTH.md) ----------------------------------------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# --- Slack app (AUTH.md; created from config/slack-app-manifest.yaml) --------
SLACK_CLIENT_ID=                             # for per-user OAuth exchange
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=                             # xoxb- — alerts only

# --- Jira service account ----------------------------------------------------
JIRA_BASE_URL=https://acme.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Anthropic (company-issued key — Commercial Terms) -----------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# --- behavior ----------------------------------------------------------------
DRY_RUN=false                                # true → render to out/, never send
