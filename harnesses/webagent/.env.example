# Copy to .env and fill in. Never commit .env — it is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Slack incoming webhook for the slack_webhook sink
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Per-task credentials. Names must match the `secrets:` list in the task YAML.
# PORTAL_USERNAME=
# PORTAL_PASSWORD=
